#ifndef __LIBVIDSTAB_VERSION_H
#define __LIBVIDSTAB_VERSION_H

#define LIBVIDSTAB_VERSION_MAJOR @MAJOR_VERSION@
#define LIBVIDSTAB_VERSION_MINOR @MINOR_VERSION@
#define LIBVIDSTAB_VERSION_MICRO @PATCH_VERSION@

/** Comparable version, e.g. LIBVIDSTAB_VERSION_INT >= LIBVIDSTAB_VERSION_MAKE(1,4,0).
    Absent before 1.4, so #ifdef it to detect an older library. */
#define LIBVIDSTAB_VERSION_MAKE(a,b,c) (((a) << 16) | ((b) << 8) | (c))
#define LIBVIDSTAB_VERSION_INT \
  LIBVIDSTAB_VERSION_MAKE(LIBVIDSTAB_VERSION_MAJOR, \
                          LIBVIDSTAB_VERSION_MINOR, \
                          LIBVIDSTAB_VERSION_MICRO)

#define LIBVIDSTAB_VERSION "v@MAJOR_VERSION@.@MINOR_VERSION@.@PATCH_VERSION@"

#endif

